android_app {
    name: "AsteroidsParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    // KeyHandler is loaded reflectively by PhoneWindowManager; R8 must not strip it
    optimize: {
        enabled: false,
    },

    static_libs: [
        "SettingsLibPreference",
        "androidx.preference_preference",
        "SettingsLib",
        "SettingsLibCollapsingToolbarBaseActivity",
    ],

    required: [
        "privapp_whitelist_org.lineageos.settings.asteroids.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.settings.asteroids.xml",
    src: "permissions/privapp_whitelist_org.lineageos.settings.asteroids.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
