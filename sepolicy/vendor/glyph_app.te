type glyph_app, domain;
app_domain(glyph_app)
typeattribute glyph_app mlstrustedsubject;

# Access to the aw20036 glyph LED controller sysfs nodes
allow glyph_app sysfs_leds:dir r_dir_perms;
allow glyph_app sysfs_leds:file rw_file_perms;

# App private data
allow glyph_app system_app_data_file:dir create_dir_perms;
allow glyph_app system_app_data_file:{ file lnk_file } create_file_perms;

# Services the app binds to
allow glyph_app {
    audio_service
    audioserver_service
    sensorservice_service
    surfaceflinger_service
    vibrator_manager_service
    activity_service
    batterystats_service
}:service_manager find;
